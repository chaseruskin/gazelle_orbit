exports_files(["LICENSE"])

# Surface the orbit CLI under a stable in-repo label. The binary itself is
# defined in the http_archive overlay at //third_party/orbit:BUILD.orbit.bazel.
alias(
    name = "orbit",
    actual = "@orbit//:orbit",
    visibility = ["//visibility:public"],
)

# Convenience alias so external consumers can refer to the gazelle binary as
# just `@gazelle_orbit` (Bazel resolves a bare module ref to a target whose
# name matches the package — here, the root package's `gazelle_orbit` target).
alias(
    name = "gazelle_orbit",
    actual = "//gazelle:gazelle_orbit",
    visibility = ["//visibility:public"],
)
