load("@gazelle_orbit_crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary")

exports_files([
    "Cargo.toml",
    "Cargo.lock",
    "LICENSE",
])

rust_binary(
    name = "orbit",
    srcs = ["src/main.rs"],
    aliases = aliases(),
    crate_name = "orbit",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = {
        "CARGO_PKG_REPOSITORY": "https://github.com/chaseruskin/orbit",
        "CARGO_PKG_VERSION": "0.29.1",
    },
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
)

# Convenience alias so external consumers can refer to the gazelle binary as
# just `@gazelle_orbit` (Bazel resolves a bare module ref to a target whose
# name matches the package — here, the root package's `gazelle_orbit` target).
alias(
    name = "gazelle_orbit",
    actual = "//gazelle:gazelle_orbit",
    visibility = ["//visibility:public"],
)
