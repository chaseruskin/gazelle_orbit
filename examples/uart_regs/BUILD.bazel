load("@rules_systemrdl//systemrdl:defs.bzl", "system_rdl_library", "verilog_system_rdl_library")

# Code-generator wrapper: PeakRDL emits uart_regs.sv + uart_regs_pkg.sv from
# the addrmap in uart_regs.rdl. Orbit doesn't run PeakRDL, so it never sees
# the emitted .sv files and can't add them to its blueprint — meaning
# downstream refs to `uart_regs` / `uart_regs_pkg` produce no dep on their
# own. Consumers (see //dsp:dsp_top) pin the dep on this rule by hand with
# a `# keep` comment on the dep line.
#
# Naming convention (all three must agree for PeakRDL + the toolchain to
# line up):
#   * addrmap inside uart_regs.rdl              -> "uart_regs"
#   * system_rdl_library target name            -> "uart_regs"
#   * Verilog module / package PeakRDL emits    -> uart_regs / uart_regs_pkg
#
# PeakRDL's regblock exporter derives output filenames from the addrmap
# name (uart_regs.sv, uart_regs_pkg.sv), and rules_systemrdl's toolchain
# expects those filenames to match the system_rdl_library target name.
#
# Building requires a rules_systemrdl toolchain (PeakRDL + Python). See
# https://hw-bzl.github.io/rules_systemrdl/.

system_rdl_library(
    name = "uart_regs_rdl",
    srcs = ["uart_regs.rdl"],
    exporter_args = {
        "regblock": [
            "--cpuif",
            "axi4-lite-flat",
        ],
    },
    output_name = "uart_regs",
)

verilog_system_rdl_library(
    name = "uart_regs",
    lib = ":uart_regs_rdl",
    visibility = ["//visibility:public"],
)
