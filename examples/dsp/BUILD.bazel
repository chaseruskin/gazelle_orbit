load("@rules_verilog//verilog:defs.bzl", "verilog_library")

verilog_library(
    name = "dsp_top",
    srcs = ["dsp_top.sv"],
    library = "dsp",
    visibility = ["//visibility:public"],
    deps = [
        # PeakRDL emits uart_regs.sv + uart_regs_pkg.sv at build time;
        # orbit runs at gazelle time and can't see them, so the
        # `import uart_regs_pkg::*` and `uart_regs u_regs(...)` refs
        # in dsp_top.sv produce no blueprint dep. `# keep` pins this
        # entry so Gazelle's merger preserves it across regens.
        "//uart_regs",  # keep
        "//vutils:counter",
        ":multiplier",
    ],
)

verilog_library(
    name = "multiplier",
    srcs = ["multiplier.v"],
    library = "dsp",
    visibility = ["//visibility:public"],
    deps = ["//vutils:reg_n"],
)
