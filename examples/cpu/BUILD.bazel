load("@rules_verilog//verilog:defs.bzl", "verilog_library")

verilog_library(
    name = "alu",
    srcs = ["alu.sv"],
    library = "cpu",
    tags = ["gazelle_orbit"],
    visibility = ["//visibility:public"],
    deps = ["//vutils:reg_n"],
)

verilog_library(
    name = "cpu_top",
    srcs = ["cpu_top.sv"],
    library = "cpu",
    tags = ["gazelle_orbit"],
    visibility = ["//visibility:public"],
    deps = [
        ":alu",
        "//vutils:counter",
        "//vutils:mux2",
    ],
)

verilog_library(
    name = "timer",
    srcs = ["timer.sv"],
    library = "cpu",
    tags = ["gazelle_orbit"],
    visibility = ["//visibility:public"],
    deps = [
        # Orbit can't see the build-time-generated params.svh (the
        # `write_file` output that timer.sv `` `include``s), so gazelle
        # can't compute this dep from source. `# keep` on the line
        # tells Gazelle's merger to preserve the entry across regens.
        "//preproc:params",  # keep
    ],
)
